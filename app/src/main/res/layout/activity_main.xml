<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Split screen host: [browser | divider | pinned pane]. Pane/divider are gone unless split screen is on. -->
    <LinearLayout
        android:id="@+id/splitRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/contentRoot"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/webViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <FrameLayout
            android:id="@+id/startPageRoot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/start_page_gradient">

            <ImageView
                android:id="@+id/startPageBackgroundImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />

            <View
                android:id="@+id/startPageDimOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorSurface"
                android:alpha="0.12" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/fullscreenContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/navigationLoadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/progressComposeView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:elevation="8dp" />

    </FrameLayout>

        <FrameLayout
            android:id="@+id/splitDivider"
            android:layout_width="@dimen/split_divider_width"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:contentDescription="@string/split_screen_divider"
            android:visibility="gone">

            <View
                android:layout_width="4dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/split_divider_handle" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/splitPaneRoot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/colorSurface"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/splitPaneToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <FrameLayout
                android:id="@+id/splitPaneWebViewContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/menuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Unified M3E Frosted Glass Background Scrim -->
        <View
            android:id="@+id/commonScrimView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- Compose Menu Overlay -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/menuComposeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Compose Bookmarks Overlay -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/bookmarkComposeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Compose Tabs Overlay -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/tabComposeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Compose QR Code Overlay -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/qrCodeComposeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Compose Version Check Overlay -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/versionComposeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Compose Settings Overlay -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/settingsComposeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/fabComposeView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
